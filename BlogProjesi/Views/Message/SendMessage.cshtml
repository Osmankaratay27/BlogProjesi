@model Message
@{
    ViewData["Title"] = "Yeni Mesaj Oluşturma";
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}

<h1>Yeni Mesaj Oluşturma</h1>

@using (Html.BeginForm("SendMessage", "Message", FormMethod.Post))
{
    <div class="form-group">
        <label for="receiverSearch">Alıcı E-Posta:</label>

        <!-- Arama Kutusu -->
        <input type="text" id="receiverSearch" class="form-control" placeholder="Alıcı ara..." onkeyup="filterRecipients()">
        <br />
        <!-- Dropdown (Select List) -->
        <select id="receiverSelect" name="ReceiverID" class="form-control">
            <option value="">-- Alıcı Seçin --</option>
            @foreach (var item in (List<SelectListItem>)ViewBag.RecieverUser)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>

    <br />
    
    <label>Konu</label>
    @Html.TextBoxFor(x => x.Subject, new { @class = "form-control" })
    <br />

    <label>Mesajınız</label>
    @Html.TextAreaFor(x => x.MessageDetails, 15, 3, new { @class = "form-control" })
    <br />

    <button type="submit" class="btn btn-info">Mesajı Gönder</button>
}


<script>
    function filterRecipients() {
        let input = document.getElementById("receiverSearch").value.toUpperCase();
        let select = document.getElementById("receiverSelect");
        let found = false;

        for (let i = 0; i < select.options.length; i++) {
            let txtValue = select.options[i].text.toUpperCase();

            if (txtValue.indexOf(input) > -1 && input.length > 0) {
                select.selectedIndex = i; // Aranan kişiyi seçili yap
                found = true;
                break; // İlk eşleşeni seç ve çık
            }
        }

        // Eğer eşleşen bulunamazsa, seçimi sıfırla
        if (!found) {
            select.selectedIndex = 0;
        }
    }
</script>
