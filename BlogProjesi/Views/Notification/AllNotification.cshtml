@model List<Notification>
@{
    ViewData["Title"] = "AllNotification";
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

<h1>Bildirimler</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Bildirim Türü</th>
        <th>Bildirim İçeriği</th>
        <th>Tarih</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <div class="preview-thumbnail">
                    <div class="@item.NotificationColor">
                        <i class="@item.NotificationTypeSymbol"></i>
                    </div>
                </div>
            </td>
            <td><h6 class="preview-subject font-weight-normal mb-1">@item.NotificationType</h6></td>
            <td>@item.NotificationDetails</td>
            <td>@item.NotificationDate.ToShortDateString()</td>
        </tr>
    }
</table>

