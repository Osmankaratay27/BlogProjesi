@model List<BlogProjesi.Controllers.EmployeeTestController.Class1>


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<table class="table table-bordered">
    <thead>
        <th>#</th>
        <th>Adı Soyadı</th>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Name</td>
                <td><a href="/EmployeeTest/DeleteEmployee/@item.ID" class="btn btn-outline-danger">Sil</a></td>
                <td><a href="/EmployeeTest/EditEmployee/@item.ID" class="btn btn-outline-success">Düzenle</a></td>
            </tr>
        }
    </tbody>
</table>

<a href="/EmployeeTest/AddEmployee" class="btn btn-outline-primary">Yeni Çalışan Girişi</a>